PROJECT_NAME="FastAPI Modular Auth API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"


POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=auth_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/auth_db


PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=adminpassword


JWT_SECRET_KEY=jwtCode9999
JWT_REFRESH_SECRET_KEY=jwtcode8989
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=12
EMAIL_TOKEN_EXPIRE_MINUTES=59

# Set to False if you want users to register and login immediately without verifying email
REQUIRE_EMAIL_VERIFICATION=False

# Options: "console" (prints token in terminal/response), "mailtrap", or "smtp"
EMAIL_PROVIDER=console


SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=username
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=AI_World_API
EMAILS_FROM_NAME="Auth System"